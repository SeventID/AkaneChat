{
  "name": "akanechat",
  "version": "0.1.2",
  "description": "A full-screen terminal AI chat client for OpenAI-compatible providers.",
  "license": "Apache-2.0",
  "author": "SeventID",
  "type": "module",
  "bin": {
    "akanechat": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --external @opentui/* --outfile=dist/index.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.6.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
