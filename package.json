{
  "name": "akanechat",
  "version": "0.1.5-beta.4",
  "description": "A multi-provider terminal AI workspace with native streaming and multi-model review, built with Bun and OpenTUI.",
  "license": "Apache-2.0",
  "author": "SeventID",
  "type": "module",
  "bin": {
    "akanechat": "akanechat"
  },
  "files": [
    "akanechat",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --external @opentui/* --outfile=dist/index.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test tests/*.test.ts"
  },
  "dependencies": {
    "@opentui/core": "npm:@androidtui/core@0.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeventID/AkaneChat.git"
  },
  "homepage": "https://github.com/SeventID/AkaneChat#readme",
  "bugs": {
    "url": "https://github.com/SeventID/AkaneChat/issues"
  },
  "keywords": [
    "ai",
    "chat",
    "terminal",
    "tui",
    "llm",
    "openai-compatible",
    "bun",
    "opentui",
    "omniroute"
  ]
}
